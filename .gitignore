# docs/data_dictionary.md

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# Système
.DS_Store

# IDE
.idea/
.vscode/

# Logs d'exécution
logs/*.log
!logs/.gitkeep

# Cache de tests
.pytest_cache/
