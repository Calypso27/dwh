# Données volumineuses — ne jamais commiter
data/raw/*
!data/raw/.gitkeep
data/warehouse/*.duckdb
!data/warehouse/.gitkeep

# SQL et doc régénérés automatiquement (optionnel : à commiter si tu veux figer une version)
